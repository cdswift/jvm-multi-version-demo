<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.example.multiversion</groupId>
    <artifactId>parent</artifactId>
    <version>1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <!--
    Plugin compiled against commons-lang3 3.0. At runtime it is NOT put on the
    application classpath. The demo loads it, along with commons-lang3 3.0,
    through its own URLClassLoader.
  -->
  <artifactId>probe-lang3-v1</artifactId>
  <name>Probe plugin for commons-lang3 3.0</name>

  <dependencies>
    <dependency>
      <groupId>com.example.multiversion</groupId>
      <artifactId>probe-api</artifactId>
      <version>${project.version}</version>
      <!-- provided: the host app supplies the interface at runtime -->
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-lang3</artifactId>
      <version>${lang3.old.version}</version>
    </dependency>
  </dependencies>
</project>
