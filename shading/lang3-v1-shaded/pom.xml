<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.example.multiversion</groupId>
    <artifactId>parent</artifactId>
    <version>1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <!--
    Wrapper module: contains NO source code. Its only job is to take
    commons-lang3 ${lang3.old.version} and republish it with every class moved from
    org.apache.commons.lang3.*  ->  v1.org.apache.commons.lang3.*
  -->
  <artifactId>lang3-v1-shaded</artifactId>
  <name>commons-lang3 3.0, relocated to v1.*</name>

  <dependencies>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-lang3</artifactId>
      <version>${lang3.old.version}</version>
      <!-- optional: consumers of this module must NOT also get the original,
           un-relocated org.apache.commons.lang3 classes on their classpath -->
      <optional>true</optional>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <!-- Replace this module's (empty) jar with the shaded one, so
                   downstream modules compile against the relocated classes. -->
              <shadedArtifactAttached>false</shadedArtifactAttached>
              <createDependencyReducedPom>false</createDependencyReducedPom>

              <artifactSet>
                <includes>
                  <include>org.apache.commons:commons-lang3</include>
                </includes>
              </artifactSet>

              <relocations>
                <relocation>
                  <pattern>org.apache.commons.lang3</pattern>
                  <shadedPattern>v1.org.apache.commons.lang3</shadedPattern>
                </relocation>
              </relocations>

              <filters>
                <filter>
                  <artifact>org.apache.commons:commons-lang3</artifact>
                  <excludes>
                    <!-- The module descriptor names the ORIGINAL packages;
                         after relocation it would be a lie, so drop it. -->
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                    <!-- Original jar signature/metadata no longer matches -->
                    <exclude>META-INF/MANIFEST.MF</exclude>
                    <exclude>META-INF/maven/**</exclude>
                  </excludes>
                </filter>
              </filters>

              <transformers>
                <!-- Rewrites META-INF/services/* entries to the relocated names -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
