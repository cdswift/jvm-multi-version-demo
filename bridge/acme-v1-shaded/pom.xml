<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.example.multiversion</groupId>
    <artifactId>parent</artifactId>
    <version>1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <!--
    Wrapper for the whole ACME 1.0 bundle (acme-model + acme-wire). No code:
    it repackages both jars into one, moving every class from
    com.acme.*  ->  v1.com.acme.*
    One relocation rule covers the bundle because both libraries share the
    com.acme root. References between them (wire -> model) are rewritten too.
  -->
  <artifactId>acme-v1-shaded</artifactId>
  <name>ACME 1.0 bundle, relocated to v1.*</name>

  <dependencies>
    <dependency>
      <groupId>com.acme</groupId>
      <artifactId>acme-wire</artifactId>
      <version>1.0</version>
      <!-- Keeps the original com.acme classes (wire AND its transitive model
           jar) off the consumer's classpath. Safe only because the shade
           config below bundles all of them. -->
      <optional>true</optional>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <shadedArtifactAttached>false</shadedArtifactAttached>
              <createDependencyReducedPom>false</createDependencyReducedPom>

              <artifactSet>
                <includes>
                  <!-- Every jar in the bundle, including transitive ones -->
                  <include>com.acme:*</include>
                </includes>
              </artifactSet>

              <relocations>
                <relocation>
                  <pattern>com.acme</pattern>
                  <shadedPattern>v1.com.acme</shadedPattern>
                </relocation>
              </relocations>

              <filters>
                <filter>
                  <artifact>com.acme:*</artifact>
                  <excludes>
                    <exclude>META-INF/maven/**</exclude>
                  </excludes>
                </filter>
              </filters>

              <transformers>
                <!-- acme-wire finds its codec with ServiceLoader. This renames
                     META-INF/services/com.acme.wire.OrderCodec to
                     META-INF/services/v1.com.acme.wire.OrderCodec and rewrites
                     the class name inside it. Without it, Codecs.load() fails. -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
